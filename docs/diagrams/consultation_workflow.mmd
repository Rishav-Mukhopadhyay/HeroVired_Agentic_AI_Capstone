---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load_patient(load_patient)
	planner(planner)
	scribe(scribe)
	diagnostician(diagnostician)
	pharmacist(pharmacist)
	physician_review(physician_review)
	ehr_writer(ehr_writer)
	__end__([<p>__end__</p>]):::last
	__start__ --> load_patient;
	diagnostician --> physician_review;
	load_patient --> planner;
	pharmacist --> physician_review;
	physician_review -.-> __end__;
	physician_review -.-> ehr_writer;
	planner --> scribe;
	scribe -.-> diagnostician;
	scribe -.-> pharmacist;
	scribe -.-> physician_review;
	ehr_writer --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
