# Copy this file to .env and fill in your values. .env is git-ignored.

# --- LLMs ---
GEMINI_API_KEY=
# Main model used while building. Run scripts/check_setup.py to see which models your key can use.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

ANTHROPIC_API_KEY=
# Cheap Claude model, used only for comparison + final demo (limited credit)
CLAUDE_MODEL=claude-haiku-5-5

# --- Monitoring (Langfuse Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local services (docker-compose.yml) ---
FHIR_BASE_URL=http://localhost:8080/fhir
POSTGRES_URL=postgresql+psycopg://mediscribe:mediscribe@localhost:5432/mediscribe
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mediscribe123

# --- Speech-to-text ---
# tiny | base | small  (small = better accuracy, slower on CPU)
WHISPER_MODEL=base
